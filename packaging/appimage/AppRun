#!/bin/sh
# AppRun entry point for the lennys-benchmark AppImage (fallback if linuxdeploy did
# not create one.  Resolves the mount point so the payload is relocatable.
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/lennys-benchmark" "$@"
